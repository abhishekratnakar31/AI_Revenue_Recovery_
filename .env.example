# Environment Configuration for RecoverAI

# Database
DATABASE_URL=postgresql://recoverai:recoverai_secret@localhost:5432/recoverai_db
TEST_DATABASE_URL=sqlite:///./test.db

# Server
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Razorpay Integration (Test Mode)
RAZORPAY_KEY_ID=rzp_test_dummy_key_id
RAZORPAY_KEY_SECRET=dummy_key_secret
RAZORPAY_WEBHOOK_SECRET=dummy_webhook_secret

# Gemini AI API
GEMINI_API_KEY=dummy_gemini_api_key
LLM_PROVIDER=mock  # Options: mock, gemini

# Merchant Policy Defaults
DEFAULT_MAX_RETRIES=2
DEFAULT_MIN_RETRY_INTERVAL_MINUTES=30
DEFAULT_MAX_NOTIFICATIONS_PER_24H=2
DEFAULT_MANUAL_APPROVAL_THRESHOLD=25000.0
