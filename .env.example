# ==================================================
# 🔑 RecoverAI Production & Live Demo Environment Config
# ==================================================

# --------------------------------------------------
# 1. Google Gemini AI Integration
# Get your API key from Google AI Studio: https://aistudio.google.com/
# --------------------------------------------------
GEMINI_API_KEY=your_actual_gemini_api_key_here
LLM_PROVIDER=gemini  # Set to 'gemini' to enable live LLM calls, or 'mock' for offline testing

# --------------------------------------------------
# 2. Razorpay API Integration (Test Mode Sandbox Keys)
# Get keys from Razorpay Dashboard -> Settings -> API Keys
# --------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# --------------------------------------------------
# 3. Database Connection URL
# --------------------------------------------------
DATABASE_URL=postgresql://recoverai:recoverai_secret@localhost:5432/recoverai_db

# --------------------------------------------------
# 4. Frontend API Base URL
# --------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
